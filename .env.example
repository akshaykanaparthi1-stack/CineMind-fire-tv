# CineMind AI - TMDB Integration Configuration
# Obtain your free API key at: https://www.themoviedb.org/settings/api

# Option 1: TMDB API Key (v3) - Recommended
TMDB_API_KEY=your_tmdb_api_key_here

# Option 2: TMDB API Read Access Token (v4 Bearer) - Optional Alternative
# TMDB_READ_ACCESS_TOKEN=your_v4_bearer_token_here

# NOTE: These credentials are used ONLY by the server-side backend proxy in Vite.
# They are never bundled or exposed to client-side browsers.
# If no key is set, CineMind AI seamlessly operates using its built-in sample catalog.
