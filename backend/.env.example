# CineMind - FastAPI Backend Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Supabase Credentials (Used securely exclusively by FastAPI backend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# AI Provider Configuration (Options: auto | bedrock | openai | fallback)
# Prefers Amazon Bedrock if AWS credentials are configured, then OpenAI, or falls back to deterministic NLP engine
AI_PROVIDER=auto

# Amazon Bedrock Credentials (Recommended for Fire TV Track)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Alternative: OpenAI API (Supported via clean provider adapter)
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o-mini

